{
  "name": "tacitweave",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "inner:storyboard": "tsx scripts/inner-storyboard.ts",
    "measure:build": "tsx scripts/measure-baseline.ts",
    "check:symbolic-path": "tsx scripts/check-symbolic-path.ts",
    "measure:browser": "tsx scripts/measure-browser.ts",
    "measure:browser:full": "tsx scripts/measure-browser.ts --full",
    "eval:validate": "cargo run -q --manifest-path rust/Cargo.toml -p tacitweave-ops -- eval-validate",
    "capture:hash": "cargo run -q --manifest-path rust/Cargo.toml -p tacitweave-ops -- capture-hash",
    "capture:verify": "cargo run -q --manifest-path rust/Cargo.toml -p tacitweave-ops -- capture-verify",
    "genie:status": "cargo run -q --manifest-path rust/Cargo.toml -p tacitweave-ops -- genie-status",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml",
    "tauri": "cd apps/desktop && ../../node_modules/.bin/tauri",
    "tauri:dev": "cd apps/desktop && ../../node_modules/.bin/tauri dev",
    "tauri:build": "cd apps/desktop && CARGO_PROFILE_RELEASE_STRIP=none ../../node_modules/.bin/tauri build",
    "bci:bridge": "tsx scripts/bci3-bridge.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "release:check": "sh scripts/release-check.sh",
    "package:macos": "sh scripts/package-macos.sh",
    "updater:manifest": "node scripts/make-updater-manifest.mjs",
    "lsm0:baseline": "tsx scripts/lsm0-baseline.ts",
    "lsm0:export": "tsx scripts/lsm0-export.ts",
    "bci:replay": "tsx scripts/bci3-replay.ts",
    "sil:test": "tsx scripts/sil-harness.ts",
    "sil:report": "tsx scripts/sil-harness.ts --out artifacts/sil-report.json",
    "lsm0:precision": "tsx scripts/lsm0-precision.ts",
    "license:js": "node scripts/check-js-licenses.mjs",
    "lsm0:public": "tsx scripts/lsm0-public-data.ts",
    "lsm1:synthetic": "tsx scripts/lsm1-synthetic.ts",
    "case:canonical": "tsx scripts/case-adapter.ts",
    "qol:canonical": "tsx scripts/qol-adapter.ts",
    "lsm0:method-audit": "tsx scripts/lsm0-method-audit.ts",
    "lsm0:mean-audit": "tsx scripts/lsm0-mean-audit.ts",
    "evidence:verify": "tsx scripts/evidence-verify.ts",
    "wesad:canonical": "python3 scripts/wesad_adapter.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.3.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12",
    "ws": "^8.22.1"
  },
  "license": "AGPL-3.0-or-later",
  "pnpm": {
    "overrides": {
      "source-map-js": "1.2.2"
    }
  }
}
